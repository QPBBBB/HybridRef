  - id: "board-start"
    name: "Citadel · Start here"
    meta:
      mood: "gothic"
      waystones:
        - id: "ws-1"
          name: "The basics"
          x: 0
          y: 190
          scale: 1
        - id: "ws-2"
          name: "Links and comments"
          x: 540
          y: 190
          scale: 1
    items:
