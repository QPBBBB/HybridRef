{
  "name": "hybridref",
  "version": "0.3.0",
  "description": "Browser-based image and text reference board with local YAML resources",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "demo": "node Scripts/RunDemo.cjs",
    "build": "node Scripts/Build.cjs",
    "dev": "node Scripts/Launch.cjs --build",
    "start": "node Scripts/Launch.cjs",
    "test": "vitest",
    "e2e": "node Scripts/Build.cjs && playwright test",
    "check:naming": "node Scripts/CheckNaming.cjs",
    "typecheck": "node Scripts/CheckNaming.cjs && tsc --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "bmp-js": "0.1.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.34.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/bmp-js": "0.1.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.2",
    "vite": "^5.2.2",
    "vitest": "^1.4.0"
  }
}
