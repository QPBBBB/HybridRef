{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["Source", "Scripts/**/*.ts", "E2E", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
