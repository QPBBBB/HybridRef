{
  "name": "hybridref",
  "version": "0.2.0",
  "description": "A minimal image reference board with YAML projects",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "demo": "tsx scripts/createDemo.ts",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "bmp-js": "0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.34.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/bmp-js": "0.1.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.2",
    "electron-vite": "^2.0.0",
    "tsx": "4.20.5",
    "typescript": "^5.4.2",
    "vite": "^5.2.2",
    "vitest": "^1.4.0"
  },
  "build": {
    "appId": "com.hybridref.app",
    "productName": "HybridRef",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": ["portable"], "icon": "../Resource/icon.ico" },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" },
    "fileAssociations": [{ "ext": "hbr", "name": "HybridRef Project", "description": "HybridRef YAML image board" }]
  }
}
